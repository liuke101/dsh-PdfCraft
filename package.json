{
  "name": "dsh-pdfcraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A PdfCraft panel in DSH's right sidebar, served from the profile's own origin.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "typecheck": "find . -name '*.js' -not -path './node_modules/*' -not -path './.npm-cache/*' -not -path './coverage/*' -not -path './.worktrees/*' -exec node --check {} \\;"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
