{
  "name": "dsh-pdfcraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A PdfCraft panel in DSH's right sidebar, served from the profile's own origin.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "dist/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "7.0.2"
  }
}
